NODE_ENV=development
PORT=3000

# PostgreSQL (local Docker o Supabase). Para Supabase usar el connection string con SSL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cashin
DATABASE_SSL=false

# Firma HMAC de webhooks. Vacío = modo demo (sin validación).
WEBHOOK_SECRET=dev_webhook_secret

# FakePaymentProvider: success | decline | timeout | random
FAKE_PROVIDER_MODE=success
FAKE_PROVIDER_TIMEOUT_MS=0

# Reintentos transaccionales (solo ante SQLSTATE transitorios)
DB_RETRY_MAX_ATTEMPTS=3
DB_RETRY_BASE_DELAY_MS=50

# Reconciliador de operaciones TIMEOUT_UNKNOWN / PENDING_GATEWAY estancadas
RECONCILER_ENABLED=true
RECONCILER_INTERVAL_MS=60000
RECONCILER_STALE_MS=30000
